<UserControl x:Class="PromptCore.UI.Views.BuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Builder.Name}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="260" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Button Content="{DynamicResource Btn.AddSection}" Command="{Binding AddSectionCommand}"
                        Margin="0,8,0,0" Padding="10,5" HorizontalAlignment="Left" />
                <Expander Header="{DynamicResource Var.Section}" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Fg}">
                    <StackPanel Margin="0,6,0,0">
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Variables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <WrapPanel Margin="0,4">
                                            <TextBox Width="110" Margin="0,0,6,0" ToolTip="{DynamicResource Var.Key}"
                                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox IsChecked="{Binding Required}" Content="{DynamicResource Var.Required}"
                                                      Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Fg}" />
                                            <CheckBox IsChecked="{Binding IsDropdown}" Content="{DynamicResource Var.Dropdown}"
                                                      Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Fg}" />
                                            <TextBox Width="110" Margin="0,0,6,0" ToolTip="{DynamicResource Var.Default}"
                                                     Text="{Binding Default, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Width="170" Margin="0,0,6,0" ToolTip="{DynamicResource Var.Options}"
                                                     Visibility="{Binding IsDropdown, Converter={StaticResource B2V}}"
                                                     Text="{Binding OptionsText, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="✕" Width="26"
                                                    Command="{Binding DataContext.RemoveVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{DynamicResource Btn.AddVariable}" Command="{Binding AddVariableCommand}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="{DynamicResource Btn.DetectVariables}" Command="{Binding DetectVariablesCommand}" Padding="10,4" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,8,0">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="▲" Width="28" Margin="2,0"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="▼" Width="28" Margin="2,0"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Title}" FontWeight="SemiBold"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource Brush.Fg}" />
                                    </DockPanel>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="48" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{DynamicResource Btn.Copy}" Command="{Binding CopyCommand}" Padding="10,5" Margin="0,0,6,0" />
                <Button Content="{DynamicResource Btn.Export}" Command="{Binding ExportCommand}" Padding="10,5" Margin="0,0,6,0" />
                <Button Content="{DynamicResource Btn.Import}" Command="{Binding ImportCommand}" Padding="10,5" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource Builder.Findings}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Findings}" Height="150" />
            </StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Builder.Preview}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
            </DockPanel>
        </DockPanel>
    </Grid>
</UserControl>
