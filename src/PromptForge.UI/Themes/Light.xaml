<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Emerald Day — light theme tokens (same token names as Emerald Night).
      Accent is emerald-700 #047857: white button text on it reaches WCAG AA (>= 4.5:1).
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F3F6F5" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputHover" Color="#EEF3F1" />
    <SolidColorBrush x:Key="Brush.Header" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border" Color="#DEE5E2" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C3CECA" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Fg" Color="#152024" />
    <SolidColorBrush x:Key="Brush.FgSubtle" Color="#45545C" />
    <SolidColorBrush x:Key="Brush.FgMuted" Color="#77868D" />
    <SolidColorBrush x:Key="Brush.FgOnPanel" Color="#1A262B" />

    <!-- Accent (emerald) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#047857" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#059669" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#065F46" />
    <SolidColorBrush x:Key="Brush.AccentFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#DDEEE7" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#B7DFCE" />

    <!-- Status colors -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBE9E9" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.Info" Color="#2563EB" />

    <!-- Legacy keys kept for compatibility -->
    <SolidColorBrush x:Key="Brush.Dropdown" Color="#FFFFFF" />
</ResourceDictionary>
