<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Emerald Night — dark theme tokens
      Surfaces step up in lightness as they get closer to the user (Bg → Panel → Input).
      Accent is emerald #10B981; text on accent is near-black green for WCAG-safe contrast.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#12151B" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#1A1E26" />
    <SolidColorBrush x:Key="Brush.Input" Color="#222833" />
    <SolidColorBrush x:Key="Brush.InputHover" Color="#2A3140" />
    <SolidColorBrush x:Key="Brush.Header" Color="#161A21" />
    <SolidColorBrush x:Key="Brush.Card" Color="#1F2530" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border" Color="#2C3440" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3D4859" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Fg" Color="#E9EEF4" />
    <SolidColorBrush x:Key="Brush.FgSubtle" Color="#A7B4C2" />
    <SolidColorBrush x:Key="Brush.FgMuted" Color="#71808F" />
    <SolidColorBrush x:Key="Brush.FgOnPanel" Color="#DCE4EC" />

    <!-- Accent (emerald) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#10B981" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0B8F66" />
    <SolidColorBrush x:Key="Brush.AccentFg" Color="#07271B" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#17402F" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#1E5240" />

    <!-- Status colors -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3B2226" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />

    <!-- Legacy keys kept for compatibility -->
    <SolidColorBrush x:Key="Brush.Dropdown" Color="#222833" />
</ResourceDictionary>
