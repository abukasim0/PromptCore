<Window x:Class="PromptForge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PromptForge.UI"
        Title="PromptForge" Width="960" Height="780" MinWidth="720" MinHeight="600" FontSize="14"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Fg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:LocalDateConverter x:Key="LocalDate" />
        <ui:StarTextConverter x:Key="StarText" />
        <ui:CountTextConverter x:Key="CountText" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Header}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="Theme_Click"
                            Content="{DynamicResource Btn.Theme}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource GhostButton}" Click="Lang_Click"
                            Content="{DynamicResource Btn.Language}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleLibraryCommand}"
                            Content="{DynamicResource Btn.Library}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource BrandDot}" />
                    <TextBlock Style="{StaticResource BrandTitle}" Text="PromptForge" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- == Library panel (collapsible) == -->
            <Border Grid.Column="0" Width="286" Margin="14,14,0,14"
                    Visibility="{Binding IsLibraryOpen, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,2,2,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3"
                                Command="{Binding FavoritesFilterCommand}"
                                ToolTip="{DynamicResource Library.Favorites}">
                            <TextBlock Text="{DynamicResource Library.FavoriteOff}"
                                       Foreground="{DynamicResource Brush.Warning}" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FavoritesOnly}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Library.FavoriteOn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BrandTitle}" FontSize="15"
                                       Text="{DynamicResource Library.Title}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FgMuted}"
                                       Margin="8,2,0,0" VerticalAlignment="Center"
                                       Text="{Binding SavedItems.Count, Converter={StaticResource CountText}}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="2,0,2,8">
                        <TextBox x:Name="SearchBoxCtl" Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{DynamicResource Library.Search}" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.FgMuted}" FontSize="13"
                                   Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                            <ItemsControl ItemsSource="{Binding SavedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SavedCard}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SavedTitle}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource SavedMeta}"
                                                           Text="{Binding UpdatedAt, Converter={StaticResource LocalDate}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.LoadSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{DynamicResource Library.Load}" />
                                                    <Button Padding="7,3" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock FontSize="14" Foreground="{DynamicResource Brush.Warning}"
                                                                   Text="{Binding IsFavorite, Converter={StaticResource StarText}}" />
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.CopySavedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{DynamicResource Btn.CopyResult}" />
                                                    <Button Style="{StaticResource DangerGhostButton}" Padding="8,3"
                                                            Command="{Binding DataContext.DeleteSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{DynamicResource Library.Delete}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{DynamicResource Library.Empty}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.FgMuted}" Margin="8" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SavedItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- == Editor == -->
            <Grid Grid.Column="1" Margin="20,16,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Simple.Idea}" Style="{StaticResource Label}" />
                <TextBox Grid.Row="1" Text="{Binding Idea, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="128" />

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Simple.Type}" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                                  DisplayMemberPath="DisplayName" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Simple.Model}" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="5" Text="{DynamicResource Simple.Result}" Style="{StaticResource Label}" />
                <TextBox Grid.Row="6" Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" Background="{DynamicResource Brush.Panel}" />

                <DockPanel Grid.Row="7" Margin="0,16,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <Button DockPanel.Dock="Left" Command="{Binding SaveCommand}"
                            Content="{DynamicResource Btn.Save}" Padding="18,9" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Command="{Binding CopyCommand}"
                            Content="{DynamicResource Btn.Copy}" Padding="22,9" FontWeight="SemiBold" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
